{
  "name": "raisondetre",
  "version": "1.0.0",
  "description": "A C++ library for API server used to integrate with popular Cloud native databases.",
  "supports": "linux",
  "dependencies": [
    {
      "name": "boost-iostreams",
      "features": [
        "zlib"
      ]
    },
    "google-cloud-cpp"
  ],
  "default-features": [
    "debian-trixie-slim"
  ],
  "features": {
    "debian-bookworm": {
      "description": "Pre-compiled binary for Debian 12 (Bookworm)"
    },
    "debian-trixie-slim": {
      "description": "Pre-compiled binary for Debian 13 (Trixie Slim)"
    },
    "ubuntu-2404": {
      "description": "Pre-compiled binary for Ubuntu 24.04 LTS"
    },
    "arm64-osx": {
      "description": "Pre-compiled binary for MacOS ARM64 (Apple Silicon)"
    }
  }
}
